# Database (SQLite-bestand op projectroot in dev)
DATABASE_URL="file:./dev.db"

# Sessie-signering (minimaal 32 tekens; in productie uniek en geheim)
AUTH_SECRET="vervang-dit-door-een-willekeurige-string-van-minimaal-32-tekens"

# Eerste admin-account (npx prisma db seed)
ADMIN_EMAIL="admin@mlauto.nl"
ADMIN_PASSWORD="kies-een-sterk-wachtwoord-minimaal-8-tekens"

# Uploads-map (buiten 'public'; elk pad dat niet absoluut is telt vanaf projectroot)
DATA_DIR="data"

# SMTP (optioneel; leeg = notificatie wordt overgeslagen)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@mlauto.nl"
MAIL_TO="info@mlauto.nl"

# Logging-niveau: debug | info | warn | error
LOG_LEVEL="info"