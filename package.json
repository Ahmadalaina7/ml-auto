{
  "name": "ml-auto",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": [
    "next",
    "sharp",
    "prisma",
    "@prisma/client",
    "@prisma/engines",
    "@prisma/adapter-better-sqlite3",
    "better-sqlite3",
    "@tailwindcss/oxide",
    "esbuild",
    "unrs-resolver"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "deploy:plesk": "bash scripts/plesk-deploy.sh"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "jose": "6.2.12",
    "next": "16.3.5",
    "nodemailer": "10.0.9",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "6.0.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "vitest": "5.0.0"
  }
}
